{
  "name": "ai-video-creation",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "scripts",
    "studio"
  ],
  "devDependencies": {
    "@eslint/js": "9.39.3",
    "@types/node": "26.1.1",
    "eslint": "9.39.3",
    "prettier": "3.9.5",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2"
  },
  "scripts": {
    "create": "npm --workspace scripts run create --",
    "analyze": "npm --workspace scripts run analyze --",
    "beats": "npm --workspace scripts run beats --",
    "evaluate": "npm --workspace scripts run evaluate --",
    "studio:dev": "npm --workspace studio run dev",
    "studio:build": "npm --workspace studio run build",
    "studio": "npm --workspace studio run start",
    "studio:test": "npm --workspace studio test",
    "test": "npm --workspace scripts test && npm --workspace studio test",
    "lint": "npm --workspace scripts run lint && npm --workspace studio run lint",
    "format": "npm --workspace scripts run format && npm --workspace studio run format",
    "typecheck": "npm --workspace scripts run typecheck && npm --workspace studio run typecheck"
  },
  "engines": {
    "node": ">=20"
  }
}
